# Ledger — rebuildable from transcripts + extractions, and account-specific
data/harness.db
data/harness.db-wal
data/harness.db-shm
data/audio/
data/prices/
runs/
# ...but extraction OUTPUT is not regenerable — it is hand-classified judgement
# and the only copy of it. Track it so the ledger can always be rebuilt.
!runs/*.extracted.json

# Transcripts ARE committed (data/transcripts/). They're ~11MB, and
# re-acquiring them depends on YouTube continuing to cooperate.

# Secrets — never commit broker or notification credentials
.env
config/secrets.json

__pycache__/
*.pyc
.DS_Store
